{% extends "base.html.j2" %}
{% block titulo %}Observatório Nacional da Formação em Fisioterapia{% endblock %}

{% block cabeca %}
<link rel="stylesheet" href="{{ depth }}static/vendor/leaflet/leaflet.css">
{% endblock %}

{% block conteudo %}

{#
  Herói editorial. Os números vêm todos de `panorama`, nunca escritos à mão no
  texto: uma manchete com número digitado sobrevive à mudança do dado e vira a
  primeira coisa errada que o leitor encontra.
#}
<section class="heroi">
  <div class="heroi-interno">
    <p class="heroi-etiqueta">Censo da Educação Superior {{ panorama.ano_censo }} · CPC 2023 · CNES</p>
    {#
      A manchete carrega a DISTÂNCIA entre os dois números, não um deles.
      "Se ensina em 380 municípios" é verdade sobre o presencial e falso sobre
      o país: 62% da capacidade deste curso é a distância, e por polo a
      formação alcança quatro vezes mais municípios. Publicar só o presencial
      subestimaria o alcance; publicar só o total esconderia que quase todo
      esse alcance é EaD. A manchete que informa é a que mostra a diferença.
    #}
    {% if panorama.n_cursos_em_extincao %}
    {#
      Ramo da edição em que a lei mudou. A manchete de antes dizia a distância
      entre o alcance presencial e o alcance por polo, porque a EaD era 62% da
      capacidade. Com a modalidade extinta por decreto, repetir aquela frase
      descreveria um país que acabou — então o que a manchete carrega agora é
      a própria ruptura, e os dois lados dela: o que foi encerrado e quanta
      gente continua lá dentro.
    #}
    <h1 class="heroi-manchete">
      A formação em Fisioterapia inteiramente a distância foi encerrada por
      decreto — e ainda tem
      <strong>{{ panorama.matriculas_em_extincao | numero }}</strong>
      estudantes matriculados nos
      <strong>{{ panorama.n_cursos_em_extincao | numero }}</strong>
      cursos encerrados ou em extinção.
    </h1>
    <p class="heroi-lede">
      A capacidade ativa é de {{ panorama.vagas_total | numero }} vagas anuais
      {% if panorama.ufs_sem_oferta %}
      em {{ panorama.n_ufs_com_oferta }} das 27 unidades da federação —
      {{ panorama.ufs_sem_oferta | join(', ') }} não têm nenhum curso presencial.
      {% else %}
      nas {{ panorama.n_ufs_com_oferta }} unidades da federação, sem exceção.
      {% endif %}
      {{ panorama.vagas_presencial | numero }} são presenciais e
      {{ panorama.vagas_semipresencial | numero }} semipresenciais, formato
      criado pelo mesmo Marco Regulatório de 2025. Nenhuma é inteiramente a
      distância.
      {% if panorama.ingressos_em_extincao %}
      Ainda assim, {{ panorama.ingressos_em_extincao | numero }} pessoas
      ingressaram neste ano em curso já declarado em extinção: o encerramento
      é um processo com prazo, não uma porta que fechou.
      {% endif %}
    </p>
    {% else %}
    <h1 class="heroi-manchete">
      A Fisioterapia tem curso presencial em
      <strong>{{ panorama.municipios_oferta | numero }}</strong>
      dos {{ panorama.municipios_total | numero }} municípios brasileiros —
      {% if panorama.polos_municipios %}
      e chega, por polo de EaD, a
      <strong>{{ panorama.polos_municipios | numero }}</strong>.
      {% endif %}
    </h1>
    <p class="heroi-lede">
      São {{ panorama.vagas_total | numero }} vagas anuais
      {% if panorama.ufs_sem_oferta %}
      em {{ panorama.n_ufs_com_oferta }} das 27 unidades da federação —
      {{ panorama.ufs_sem_oferta | join(', ') }} não têm nenhum curso presencial.
      {% else %}
      nas {{ panorama.n_ufs_com_oferta }} unidades da federação, sem exceção.
      {% endif %}
      {% if panorama.pct_ead is not none %}
      {{ panorama.pct_ead | numero }}% delas são a distância, registradas na
      sede da mantenedora e atendidas por
      {{ panorama.polos_registros | numero }} polos.
      {% endif %}
    </p>
    {% endif %}
    <p class="heroi-nota">
      Este observatório não estima nada. Onde não há fonte oficial para um
      recorte, a página diz <em>sem dados</em> — e o mapa fica cinza.
    </p>
  </div>
</section>

<section class="secao">
  <h2 class="secao-titulo">Panorama nacional</h2>
  <div class="kpis">
    <div class="kpi">
      <span class="kpi-valor">{{ panorama.vagas_total | numero }}</span>
      <span class="kpi-rotulo">Vagas anuais</span>
      <span class="kpi-nota">{{ panorama.vagas_presencial | numero }} presenciais
        {%- if panorama.vagas_semipresencial %} ·
        {{ panorama.vagas_semipresencial | numero }} semipresenciais
        {%- else %} · {{ panorama.vagas_ead | numero }} EaD{% endif %}</span>
    </div>
    <div class="kpi">
      <span class="kpi-valor">{{ panorama.matriculas | numero }}</span>
      <span class="kpi-rotulo">Matrículas</span>
      <span class="kpi-nota">{{ panorama.concluintes | numero }} concluintes no ano{%
        if panorama.sem_localizacao %} · soma dos estados; o Censo traz mais
        {{ panorama.sem_localizacao | numero }} sem localização declarada{% endif %}</span>
    </div>
    <div class="kpi">
      <span class="kpi-valor">{{ panorama.municipios_oferta }}</span>
      <span class="kpi-rotulo">Municípios com curso presencial</span>
      <span class="kpi-nota">{{ panorama.municipios_deserto | numero }} sem nenhum</span>
    </div>
    <div class="kpi">
      <span class="kpi-valor">{{ panorama.cursos_avaliados }}</span>
      <span class="kpi-rotulo">Cursos avaliados no CPC 2023</span>
      <span class="kpi-nota">em {{ panorama.ufs_avaliadas }} das 27 UFs</span>
    </div>
    {% if panorama.n_cursos_em_extincao %}
    <div class="kpi">
      <span class="kpi-valor">{{ panorama.vagas_semipresencial | numero }}</span>
      <span class="kpi-rotulo">Vagas semipresenciais</span>
      <span class="kpi-nota">{{ panorama.n_cursos_semipresencial | numero }}
        cursos · formato criado em 2025</span>
    </div>
    <div class="kpi">
      <span class="kpi-valor">{{ panorama.vagas_em_extincao | numero }}</span>
      <span class="kpi-rotulo">Vagas encerradas ou em extinção</span>
      <span class="kpi-nota">fora da capacidade ativa ·
        {{ panorama.matriculas_em_extincao | numero }} matriculados</span>
    </div>
    {% endif %}
    <div class="kpi">
      <span class="kpi-valor">
        {%- if panorama.municipios_com_fisioterapeuta -%}
          {{ panorama.municipios_com_fisioterapeuta | numero }}
        {%- else -%}<span class="sem-dados">sem dados</span>{%- endif -%}
      </span>
      <span class="kpi-rotulo">Municípios com fisioterapeuta no SUS</span>
      <span class="kpi-nota">CNES — força de trabalho</span>
    </div>
    <div class="kpi">
      <span class="kpi-valor">
        {%- if panorama.municipios_com_servico_fisio -%}
          {{ panorama.municipios_com_servico_fisio | numero }}
        {%- else -%}<span class="sem-dados">sem dados</span>{%- endif -%}
      </span>
      <span class="kpi-rotulo">Municípios com serviço fisioterapêutico</span>
      <span class="kpi-nota">CNES — rede especializada, ofertada ao SUS{% if panorama.municipios_com_servico_fisio_total %}
        · {{ panorama.municipios_com_servico_fisio_total | numero }} contando o privado{% endif %}</span>
    </div>
  </div>
</section>

<section class="secao">
  <div class="secao-cabecalho">
    <h2 class="secao-titulo">Mapa nacional</h2>
    <label class="campo">
      Indicador
      <select id="seletor-mapa">
        {% for cat in categorias %}
        <optgroup label="{{ cat }}">
          {% for ind in catalogo if ind.cat == cat %}
          <option value="{{ ind.key }}"{% if ind.key == 'ICT' %} selected{% endif %}>{{ ind.nome }}</option>
          {% endfor %}
        </optgroup>
        {% endfor %}
      </select>
    </label>
  </div>
  <p id="mapa-explicacao" class="secao-lede"></p>
  <div id="mapa" class="mapa"></div>
  <div id="legenda" class="legenda"></div>
  <p class="nota">
    Malhas territoriais do IBGE, servidas localmente — o mapa não carrega
    imagem de terceiros e funciona offline depois da primeira visita. Clique
    num estado para abrir a página dele.
  </p>
</section>

<section class="secao">
  <div class="secao-cabecalho">
    <h2 class="secao-titulo">Estados</h2>
    <button class="botao" data-exportar="#tabela-ufs" data-nome="ufs-fisioterapia.csv">
      Baixar CSV
    </button>
    <button class="botao botao-fantasma" data-exportar-xlsx="#tabela-ufs"
            data-nome="ufs-fisioterapia.xlsx" data-aba="Estados">Baixar XLSX</button>
  </div>
  <div class="tabela-rolagem">
    <table id="tabela-ufs" data-ordenavel>
      <caption class="so-leitor">Indicadores de Fisioterapia por unidade da federação</caption>
      <thead>
        <tr>
          <th scope="col">UF</th>
          <th scope="col">Vagas totais</th>
          <th scope="col">% EaD</th>
          <th scope="col">Municípios com curso</th>
          <th scope="col">ICT</th>
          <th scope="col">IAF</th>
          <th scope="col">CPC</th>
          <th scope="col">ICAFT</th>
        </tr>
      </thead>
      <tbody>
        {% for sigla, d in ufs_ordenadas %}
        <tr{% if not d.tem_oferta_presencial %} class="linha-sem-oferta"{% endif %}>
          <td data-valor="{{ sigla }}">
            <a href="{{ depth }}uf/{{ sigla }}.html">{{ nomes_uf[sigla] }}</a>
            {% if not d.tem_oferta_presencial %}
            <span class="marca-sem-oferta" title="Sem curso presencial de Fisioterapia">sem oferta presencial</span>
            {% endif %}
          </td>
          {% for campo in ['vagas_total', 'pct_ead', 'municipios_oferta', 'ICT', 'IAF', 'CPC', 'ICAFT'] %}
          <td class="num" data-valor="{{ d[campo] if d[campo] is not none else '' }}"
              data-campo="{{ campo }}">{{ '' }}</td>
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="tabela-dica">Role a tabela para o lado para ver as demais colunas.</p>
  <p class="nota">
    As 27 unidades da federação têm curso presencial de Fisioterapia — a
    tabela não tem linha vazia por ausência de oferta. O que ela mostra é
    que presença não é cobertura: há curso em todo estado e curso
    presencial em 380 dos 5.571 municípios.
  </p>
</section>

{% endblock %}

{% block scripts %}
<script src="{{ depth }}static/vendor/leaflet/leaflet.js"></script>
<script>
const UFS = {{ ufs_json }};
const DEPTH = {{ depth | tojson }};
const NOMES_UF = {{ nomes_uf | json }};

/* Preenche as células a partir do catálogo, em vez de formatar no Jinja.
   Formatar no template exigiria repetir as casas decimais de cada indicador
   no HTML — que é exatamente a duplicação que o catálogo existe para evitar. */
document.querySelectorAll('td[data-campo]').forEach(function (td) {
  const campo = td.dataset.campo;
  const bruto = td.dataset.valor;
  const valor = bruto === '' ? null : parseFloat(bruto);
  td.textContent = fmt(valor, campo);
  if (valor === null) td.classList.add('sem-dados');
});

const mapaEl = document.getElementById('mapa');
const seletor = document.getElementById('seletor-mapa');
const legendaEl = document.getElementById('legenda');
const explicacaoEl = document.getElementById('mapa-explicacao');
let mapa = null;
let camada = null;
let malha = null;

function siglaDaFeicao(f) {
  const p = f.properties || {};
  return (p.sigla || p.SIGLA || p.sigla_uf || p.SIGLA_UF || '').toUpperCase();
}

function redesenhar() {
  const chave = seletor.value;
  const valores = Object.keys(UFS).map(s => UFS[s][chave]);
  const meta = INDICADOR_META[chave] || {};
  const usaEscalaDinamica = meta.min === null || meta.min === undefined;
  const corDinamica = usaEscalaDinamica ? escalaDinamica(valores) : null;

  const item = GLOSSARIO.filter(g => g.key === chave)[0];
  explicacaoEl.textContent = item ? item.oque : '';

  if (camada) { camada.remove(); camada = null; }
  camada = desenharMalha(mapa, malha, {
    chave: chave,
    valorDe: f => {
      const uf = UFS[siglaDaFeicao(f)];
      return uf ? uf[chave] : null;
    },
    rotuloDe: f => {
      const p = f.properties || {};
      const sigla = siglaDaFeicao(f);
      return NOMES_UF[sigla] || sigla;
    },
    corDe: corDinamica ? corDinamica : undefined,
    aoClicar: f => {
      const sigla = siglaDaFeicao(f);
      if (sigla) window.location.href = DEPTH + 'uf/' + sigla + '.html';
    },
  });
  montarLegenda(legendaEl, chave, valores);
}

fetch(DEPTH + 'static/geo/brasil.json')
  .then(r => r.json())
  .then(function (geo) {
    malha = geo;
    mapa = criarMapa(mapaEl);
    redesenhar();
    seletor.addEventListener('change', redesenhar);
  })
  .catch(function () {
    mapaEl.innerHTML = '<p class="vazio">Não foi possível carregar a malha ' +
      'territorial. Os dados continuam disponíveis na tabela abaixo.</p>';
  });
</script>
{% endblock %}
